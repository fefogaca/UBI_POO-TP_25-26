@startuml
' Diagrama de Classes Detalhado e Otimizado para Relatório A4

' --- Configurações Visuais ---
!theme plain
skinparam dpi 150
skinparam shadowing false
skinparam roundCorner 10
skinparam classAttributeIconSize 0

' Definições de Estilo para Pacotes e Classes
skinparam package {
    BorderColor #AAAAAA
    FontColor #333333
}
skinparam class {
    BackgroundColor #F8F8F8
    BorderColor #555555
    ArrowColor #555555
}
skinparam interface {
    BackgroundColor #F8F8F8
    BorderColor #555555
    ArrowColor #555555
}

' --- Definição das Classes Detalhadas por Pacote ---

package "app" <<Folder>> {
    class Main {
        + {static} main(args: String[]): void
    }
}

package "gui" <<Folder>> {
    class FarmaciaGUI extends JFrame {
        - farmacia: Farmacia
        + FarmaciaGUI(farmacia: Farmacia)
    }

    class PainelGestaoClientes extends JPanel {
        - farmacia: Farmacia
        - tabelaClientes: JTable
        + PainelGestaoClientes(farmacia: Farmacia)
        - atualizarTabela(): void
    }

    class PainelGestaoProdutos extends JPanel {
        - farmacia: Farmacia
        - tabelaProdutos: JTable
        + PainelGestaoProdutos(farmacia: Farmacia)
        + atualizarTabela(): void
    }

    class PainelGestaoEncomendas extends JPanel {
        - farmacia: Farmacia
        - tabelaEncomendas: JTable
        - painelProdutos: PainelGestaoProdutos
        + PainelGestaoEncomendas(farmacia: Farmacia, painelProdutos: PainelGestaoProdutos)
        - atualizarTabela(): void
    }
}

package "persistencia" <<Folder>> {
    class GestorDados <<static>> {
        - {static} NOME_FICHEIRO: String
        + {static} guardarDados(clientes: List, produtos: List, encomendas: List): void
        + {static} carregarDados(): Object[]
    }
}

package "modelo" <<Folder>> {
    class Farmacia {
        - produtos: List<Produto>
        - clientes: List<Cliente>
        - encomendas: List<Encomenda>
        + adicionarCliente(cliente: Cliente): void
        + removerCliente(nif: String): void
        + adicionarProduto(produto: Produto): void
        + removerProduto(id: int): void
        + registarEncomenda(cliente: Cliente, produtos: Map): void
        + removerEncomenda(id: int): void
    }
    abstract class Pessoa {
        # nome: String
        # nif: String
        + getNome(): String
        + getNif(): String
    }
    class Cliente extends Pessoa {
        - morada: Morada
        + getMorada(): Morada
    }
    class Morada {
        - rua: String
        - cidade: String
        - codPostal: String
        + toString(): String
    }
    interface Vendavel {
        + getNome(): String
        + getPreco(): double
    }
    class Produto implements Vendavel {
        - id: int
        - nome: String
        - preco: double
        - stock: int
        + getId(): int
        + getStock(): int
        + adicionarStock(qnt: int): void
        + removerStock(qnt: int): void
    }
    class Encomenda {
        - id: int
        - precoTotal: double
        - estado: EstadoEncomenda
        + getId(): int
        + getCliente(): Cliente
        + getEstado(): EstadoEncomenda
    }
    enum EstadoEncomenda {
        EM_PROCESSAMENTO
        PAGO
        ENVIADO
        ENTREGUE
    }
}

' --- Relações ---

' Camada de Apresentação (GUI)
FarmaciaGUI *-- PainelGestaoClientes
FarmaciaGUI *-- PainelGestaoProdutos
FarmaciaGUI *-- PainelGestaoEncomendas
gui ..> Farmacia : usa
PainelGestaoEncomendas ..> PainelGestaoProdutos : atualiza

' Camada de Lógica (Modelo)
Pessoa <|-- Cliente
Cliente "1" *-- "1" Morada
Vendavel <|.. Produto
Farmacia "1" *-- "0..*" Cliente
Farmacia "1" *-- "0..*" Produto
Farmacia "1" *-- "0..*" Encomenda
Encomenda o-- "1" Cliente
Encomenda "1" o-- "1..*" Produto
Encomenda +-- EstadoEncomenda

' Camada de Entrada (App)
Main ..> FarmaciaGUI : cria
Main ..> Farmacia : cria
Main ..> GestorDados : carrega

' Camada de Persistência
persistencia ..> modelo : serializa

' --- Organização do Layout (Vertical) ---
app -[hidden]D-> gui
gui -[hidden]D-> persistencia
persistencia -[hidden]D-> modelo

@enduml